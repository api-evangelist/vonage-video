{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vonage Video Archives Render API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Render",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Experience Composer renders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://video.api.vonage.com/v2/project/:applicationId/render",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "The Vonage application ID (formerly OpenTok API key)."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "count",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List Experience Composer renders"
        },
        {
          "info": {
            "name": "Start an Experience Composer render",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://video.api.vonage.com/v2/project/:applicationId/render",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "The Vonage application ID (formerly OpenTok API key)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Start an Experience Composer render"
        },
        {
          "info": {
            "name": "Get an Experience Composer render",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://video.api.vonage.com/v2/project/:applicationId/render/:renderId",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "The Vonage application ID (formerly OpenTok API key)."
              },
              {
                "name": "renderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an Experience Composer render"
        },
        {
          "info": {
            "name": "Stop an Experience Composer render",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://video.api.vonage.com/v2/project/:applicationId/render/:renderId",
            "params": [
              {
                "name": "applicationId",
                "value": "",
                "type": "path",
                "description": "The Vonage application ID (formerly OpenTok API key)."
              },
              {
                "name": "renderId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Stop an Experience Composer render"
        }
      ]
    }
  ],
  "bundled": true
}